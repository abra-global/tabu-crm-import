# ==========================================================================
# SAP Sales and Service Cloud V2 (C4C) connection
# ==========================================================================

# Full CRM host, no trailing slash.
CRM_BASE_URL=https://my1002519.de1.crm.cloud.sap

# Fixed: HTTP Basic Authentication (username + password). There is no
# OAuth2, no client credentials, no token acquisition and no token cache
# anywhere in this codebase - every CRM request computes the Basic Auth
# header directly from these two values.
CRM_AUTH_MODE=basic_auth
CRM_BASIC_USERNAME=
CRM_BASIC_PASSWORD=

# Fixed technical Account used for the "רשות הפתוח" (Government / Open
# Authority) special case. This value comes directly from the specification
# and must never be looked up or created dynamically.
SAP_GOVERNMENT_ACCOUNT_ID=01a076e8-3e32-7003-a320-fc6b22fcd359

# Reference Product displayId used when creating Registered Products.
SAP_REFERENCE_PRODUCT_DISPLAY_ID=999

# ==========================================================================
# AI extraction (Google Gemini) for reading Tabu PDFs
# ==========================================================================
# Uses the Google GenAI SDK (@google/genai, GoogleGenAI) with the PDF sent
# as an actual multimodal document part - not raw text extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ==========================================================================
# Server
# ==========================================================================
PORT=8787
# Set to "true" to log verbose CRM debug traces (URLs, ETags, payloads).
# Never enable in an environment where logs are not access-controlled.
CRM_DEBUG=true
